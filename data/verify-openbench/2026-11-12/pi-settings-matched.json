{
  "binary": "/opt/pi",
  "built_in_extensions": [
    "llama.cpp",
    "codemode",
    "tool-search",
    "mcp"
  ],
  "call_role_header": "X-OB-Call-Role",
  "cell_cap_s": 2400,
  "compaction": {
    "enabled": true,
    "keep_recent_tokens": 20000,
    "reserve_tokens": 16384
  },
  "context_window": 200000,
  "harness": "pi",
  "instrumentation": "fetch wrapper sets X-OB-Call-Role from the system text only",
  "matched_config": true,
  "model": "claude-sonnet-5-5",
  "npm_tag_is_pin": false,
  "npm_tag_v1_4_0": "<npm-tag>",
  "output_max_bytes": 51200,
  "output_max_lines": 2000,
  "package": "@earendil-works/pi-coding-agent",
  "package_version_at_pin": "1.4.0",
  "permission_mode": "no-approve",
  "pin": "<pi-pin>",
  "pin_brief": "d0aa218",
  "pin_file": "/opt/pi.pin",
  "provider": "anthropic",
  "read_max_bytes": 51200,
  "read_max_lines": 2000,
  "repo": "https://github.com/earendil-works/pi",
  "retry": {
    "base_delay_ms": 2000,
    "enabled": true,
    "max_retries": 3,
    "provider_max_retries": 0
  },
  "shell_timeout_s": null,
  "subagents": false,
  "temperature": null,
  "thinking": {
    "argv_override": true,
    "level": "off",
    "model_reasoning": true
  },
  "tools": [
    "read",
    "bash",
    "edit",
    "write"
  ],
  "tools_argv_override": false,
  "wire": {
    "api": "anthropic-messages",
    "base_url": "http://127.0.0.1:9/c/cell1",
    "openai_chat_completions": false,
    "path": "/v1/messages"
  }
}
