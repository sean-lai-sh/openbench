s the prefix, so it still passes. If anything downstream reads that exact format, it will need updating.\n\nAnything that compares these values with naive datetimes would raise `TypeError` (for example, timestamps stored before this change and loaded back in). Nothing in the repo does this, but code outside it might.", "paced_wait_s": 0.0, "params_stripped": [], "params_stripped_requests": 0, "permission_rejections": 0, "read_calls": 1, "replies_ok": 5, "replies_throttled": 0, "requests_cache_read": 74074, "requests_cache_write": 111356, "requests_cost_usd": 0.6030308, "requests_count": 5, "requests_input_uncached": 14, "requests_output": 1569, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-fanout:claude-opus-5-5:trial18", "run_seed": 1016, "sampling_observed": null, "schedule_index": 155, "score": 1.0, "started_at": "2026-10-20T03:16:23.749635+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 19.907, "t_checker_s": 0.374, "t_env_setup_s": 0.001, "task": "trig-omp-fanout", "task_calls": 0, "thinking_mode": "default", "thinking_sent": ["adaptive", "adaptive", "adaptive", "adaptive", "adaptive"], "timeout_s": 840, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 1583, "tokens_cache_read": 74074, "tokens_cache_write": 111356, "tokens_fresh": 1583, "tokens_input_uncached": 14, "tokens_main_cache_read": 74074, "tokens_main_cache_write": 111356, "tokens_main_calls": 5, "tokens_main_input_uncached": 14, "tokens_main_output": 1569, "tokens_output": 1569, "tokens_proxy_cache_read": 74074, "tokens_proxy_cache_write": 111356, "tokens_proxy_calls": 5, "tokens_proxy_input_uncached": 14, "tokens_proxy_output": 1569, "tokens_proxy_reasoning": null, "tokens_reasoning": 0, "trial": 18, "ts_iso": "2026-10-19T23:16:23", "turn_mode": null, "turns": 5, "upstream_model": "claude-opus-5-5", "usage_raw": [{"cacheRead"