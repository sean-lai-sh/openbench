ring, so it doesn't catch this.\n- **Old naive values won't mix with the new ones:** `stamp()[\"at\"]`, `due_date()`, `generated_at()`, session times and `Entry.expires` now carry a UTC timezone. Comparing or subtracting them against older naive datetimes, such as ones read back from a database or cache, raises `TypeError`. Nothing in this repo does that, but outside callers might.\n- **Left alone:** `timedelta` is imported but unused in `audit.py`, `reports.py` and `sessions.py`. That was already the case, so I didn't touch it.", "paced_wait_s": 0.0, "params_stripped": [], "params_stripped_requests": 0, "permission_rejections": 0, "read_calls": 6, "replies_ok": 6, "replies_throttled": 0, "requests_cache_read": 73966, "requests_cache_write": 154951, "requests_cost_usd": 0.8339922000000001, "requests_count": 6, "requests_input_uncached": 16, "requests_output": 2219, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-fanout:claude-opus-5-5:trial19", "run_seed": 1016, "sampling_observed": null, "schedule_index": 157, "score": 1.0, "started_at": "2026-10-20T03:16:31.962108+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 26.272, "t_checker_s": 0.376, "t_env_setup_s": 0.001, "task": "trig-omp-fanout", "task_calls": 0, "thinking_mode": "default", "thinking_sent": ["adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive"], "timeout_s": 840, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 2235, "tokens_cache_read": 73966, "tokens_cache_write": 154951, "tokens_fresh": 2235, "tokens_input_uncached": 16, "tokens_main_cache_read": 73966, "tokens_main_cache_write": 154951, "tokens_main_calls": 6, "tokens_main_input_uncached": 16, "tokens_main_output": 2219, "tokens_output": 2219, "tokens_proxy_cache_read": 73966, "tokens_proxy_cache_write": 154951, "tokens_proxy_calls": 6, "tokens_proxy_input_un