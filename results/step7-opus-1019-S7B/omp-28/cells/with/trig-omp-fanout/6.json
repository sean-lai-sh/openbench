soformat()` there.\n- **Mixing old and new timestamps:** The values from `audit.stamp`, `billing.due_date`, `reports.generated_at`, `sessions.new_session` and `cache.Entry.expires` now carry a timezone. Python raises `TypeError` if you compare or subtract one of these against a timestamp without a timezone. That can't happen inside `app/`, but outside callers or stored data that still use timestamps without a timezone would hit it.", "paced_wait_s": 0.0, "params_stripped": [], "params_stripped_requests": 0, "permission_rejections": 0, "read_calls": 6, "replies_ok": 6, "replies_throttled": 0, "requests_cache_read": 114124, "requests_cache_write": 112100, "requests_cost_usd": 0.6218688, "requests_count": 6, "requests_input_uncached": 16, "requests_output": 1924, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-fanout:claude-opus-5-5:trial6", "run_seed": 1016, "sampling_observed": null, "schedule_index": 131, "score": 1.0, "started_at": "2026-10-20T03:14:01.001496+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 60.18, "t_checker_s": 0.376, "t_env_setup_s": 0.003, "task": "trig-omp-fanout", "task_calls": 0, "thinking_mode": "default", "thinking_sent": ["adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive"], "timeout_s": 840, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 1940, "tokens_cache_read": 114124, "tokens_cache_write": 112100, "tokens_fresh": 1940, "tokens_input_uncached": 16, "tokens_main_cache_read": 114124, "tokens_main_cache_write": 112100, "tokens_main_calls": 6, "tokens_main_input_uncached": 16, "tokens_main_output": 1924, "tokens_output": 1924, "tokens_proxy_cache_read": 114124, "tokens_proxy_cache_write": 112100, "tokens_proxy_calls": 6, "tokens_proxy_input_uncached": 16, "tokens_proxy_output": 1924, "tokens_proxy_reasoning": null, "tokens_reasoning": 0, "trial": 