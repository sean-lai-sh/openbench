`+00:00`.\n- **Mixing old and new datetimes:** values from `stamp`, `due_date`, `generated_at`, `new_session` and `Entry.expires` now carry a timezone. Python raises a `TypeError` if you compare them with, or subtract them from, datetimes that have no timezone. Nothing in this repo does that, but code outside it that uses these values, or loads old timestamps from storage, could hit it.\n\n`timedelta` is still imported but unused in `audit.py`, `reports.py` and `sessions.py`; I left those imports alone because removing them wasn't part of this change.", "paced_wait_s": 0.0, "params_stripped": [], "params_stripped_requests": 0, "permission_rejections": 0, "read_calls": 1, "replies_ok": 5, "replies_throttled": 0, "requests_cache_read": 34967, "requests_cache_write": 147601, "requests_cost_usd": 0.7733944, "requests_count": 5, "requests_input_uncached": 14, "requests_output": 1417, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-fanout:claude-opus-5-5:trial28", "run_seed": 1016, "sampling_observed": null, "schedule_index": 174, "score": 1.0, "started_at": "2026-10-20T03:18:06.814030+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 23.921, "t_checker_s": 0.373, "t_env_setup_s": 0.001, "task": "trig-omp-fanout", "task_calls": 0, "thinking_mode": "default", "thinking_sent": ["adaptive", "adaptive", "adaptive", "adaptive", "adaptive"], "timeout_s": 840, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 1431, "tokens_cache_read": 34967, "tokens_cache_write": 147601, "tokens_fresh": 1431, "tokens_input_uncached": 14, "tokens_main_cache_read": 34967, "tokens_main_cache_write": 147601, "tokens_main_calls": 5, "tokens_main_input_uncached": 14, "tokens_main_output": 1417, "tokens_output": 1417, "tokens_proxy_cache_read": 34967, "tokens_proxy_cache_write": 147601, "tokens_proxy_calls": 5, "tokens_proxy_input_