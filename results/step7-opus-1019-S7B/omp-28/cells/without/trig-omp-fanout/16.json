n that function.\n\nEverything these modules return (`stamp`, `due_date`, `generated_at`, the session timestamps and cache expiry) is now timezone-aware. Any caller outside these files that compares or subtracts them against plain naive datetimes will raise a `TypeError`. Inside `app/`, aware values are only ever compared with each other, so nothing breaks there.", "paced_wait_s": 0.0, "params_stripped": [], "params_stripped_requests": 0, "permission_rejections": 0, "read_calls": 1, "replies_ok": 5, "replies_throttled": 0, "requests_cache_read": 34966, "requests_cache_write": 148046, "requests_cost_usd": 0.7756992, "requests_count": 5, "requests_input_uncached": 14, "requests_output": 1421, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-fanout:claude-opus-5-5:trial16", "run_seed": 1016, "sampling_observed": null, "schedule_index": 150, "score": 1.0, "started_at": "2026-10-20T03:15:58.165349+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 22.24, "t_checker_s": 0.376, "t_env_setup_s": 0.001, "task": "trig-omp-fanout", "task_calls": 0, "thinking_mode": "default", "thinking_sent": ["adaptive", "adaptive", "adaptive", "adaptive", "adaptive"], "timeout_s": 840, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 1435, "tokens_cache_read": 34966, "tokens_cache_write": 148046, "tokens_fresh": 1435, "tokens_input_uncached": 14, "tokens_main_cache_read": 34966, "tokens_main_cache_write": 148046, "tokens_main_calls": 5, "tokens_main_input_uncached": 14, "tokens_main_output": 1421, "tokens_output": 1421, "tokens_proxy_cache_read": 34966, "tokens_proxy_cache_write": 148046, "tokens_proxy_calls": 5, "tokens_proxy_input_uncached": 14, "tokens_proxy_output": 1421, "tokens_proxy_reasoning": null, "tokens_reasoning": 0, "trial": 16, "ts_iso": "2026-10-19T23:15:58", "turn_mode": null, "turns": 5, "upstream_model":