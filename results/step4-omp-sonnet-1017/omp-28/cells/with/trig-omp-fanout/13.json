.stamp`, `billing.due_date`, `reports.generated_at` and `sessions.new_session`, and the expiry time inside `cache.Entry`, are now aware. Comparing or subtracting one against a naive `datetime` raises `TypeError`. Nothing in this repo does that. External callers that mix the two would break.", "paced_wait_s": 0.0, "params_stripped": [], "params_stripped_requests": 0, "permission_rejections": 0, "read_calls": 1, "replies_ok": 4, "replies_throttled": 0, "requests_cache_read": 37583, "requests_cache_write": 109638, "requests_cost_usd": 0.29216329999999996, "requests_count": 4, "requests_input_uncached": 10, "requests_output": 1429, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-fanout:claude-opus-5-5:trial13", "run_seed": 1016, "sampling_observed": null, "schedule_index": 205, "score": 1.0, "started_at": "2026-10-17T23:25:39.649871+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 13.514, "t_checker_s": 0.324, "t_env_setup_s": 0.001, "task": "trig-omp-fanout", "task_calls": 0, "thinking_mode": "default", "thinking_sent": ["adaptive", "adaptive", "adaptive", "adaptive"], "timeout_s": 840, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 1439, "tokens_cache_read": 37583, "tokens_cache_write": 109638, "tokens_fresh": 1439, "tokens_input_uncached": 10, "tokens_main_cache_read": 37583, "tokens_main_cache_write": 109638, "tokens_main_calls": 4, "tokens_main_input_uncached": 10, "tokens_main_output": 1429, "tokens_output": 1429, "tokens_proxy_cache_read": 37583, "tokens_proxy_cache_write": 109638, "tokens_proxy_calls": 4, "tokens_proxy_input_uncached": 10, "tokens_proxy_output": 1429, "tokens_proxy_reasoning": null, "tokens_reasoning": 0, "trial": 13, "ts_iso": "2026-10-17T19:25:39", "turn_mode": null, "turns": 4, "upstream_model": "claude-sonnet-5-5", "usage_raw": [{"cacheRead": 0, "cacheWrite": 35359, "