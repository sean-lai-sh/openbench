the decimal part of a float. Floats can't store most prices exactly, so `19.99 * 100` comes out as `1998.9999\u2026` and gets cut to `1998`. `0.29 * 100` came out as 28 the same way, so 3 units gave 84 instead of 87. `4.35` lost a cent per unit too, which is why the discounted total came out at 781 instead of 783.\n\n**Fix:** `to_cents` now converts through `Decimal(str(amount))` and rounds half up to a whole cent. That gives the exact decimal value instead of the float approximation, and half-up matches how `discounts.apply_percent` and `tax.tax_cents` already round. `to_cents` is only called from `Line.cents()`, so nothing else changes.", "paced_wait_s": 0.0, "params_stripped": [], "params_stripped_requests": 0, "permission_rejections": 0, "provider_error": "Anthropic stream stalled while waiting for the next event", "read_calls": 6, "replies_ok": 3, "replies_throttled": 0, "requests_cache_read": 30929, "requests_cache_write": 191400, "requests_cost_usd": 0.9969498, "requests_count": 7, "requests_input_uncached": 16, "requests_output": 1685, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-multistep:claude-opus-5-5:trial6", "run_seed": 1016, "sampling_observed": null, "schedule_index": 191, "score": 1.0, "started_at": "2026-10-20T02:26:12.160722+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 146.684, "t_checker_s": 0.435, "t_env_setup_s": 0.001, "task": "trig-omp-multistep", "task_calls": 0, "thinking_mode": "default", "thinking_sent": ["adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive"], "timeout_s": 840, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 1701, "tokens_cache_read": 30929, "tokens_cache_write": 191400, "tokens_fresh": 1765, "tokens_input_uncached": 16, "tokens_main_cache_read": 30929, "tokens_main_cache_write": 223998, "tokens_main_calls": 8, "t