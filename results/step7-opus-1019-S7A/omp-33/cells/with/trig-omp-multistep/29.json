u2192 1998, 0.29 \u2192 28, 4.35 \u2192 434. The tax test passed only because `10.00 * 100` happens to be exact.\n\n**The fix:** `to_cents` now turns the price into an exact decimal via `Decimal(str(amount))`, multiplies by 100, and rounds half up. That matches how `apply_percent` already rounds discounts. I didn't use plain `round()` because Python's `round()` sends exact halves to the even number, which wouldn't match the half-up rule used elsewhere. `Line.cents()` is the only caller, so nothing else needed changing.", "paced_wait_s": 0.0, "params_stripped": [], "params_stripped_requests": 0, "permission_rejections": 0, "read_calls": 6, "replies_ok": 7, "replies_throttled": 0, "requests_cache_read": 124622, "requests_cache_write": 98005, "requests_cost_usd": 0.5509934, "requests_count": 7, "requests_input_uncached": 16, "requests_output": 1799, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-multistep:claude-opus-5-5:trial29", "run_seed": 1016, "sampling_observed": null, "schedule_index": 237, "score": 1.0, "started_at": "2026-10-20T02:39:08.125649+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 23.783, "t_checker_s": 0.377, "t_env_setup_s": 0.001, "task": "trig-omp-multistep", "task_calls": 0, "thinking_mode": "default", "thinking_sent": ["adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive"], "timeout_s": 840, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 1815, "tokens_cache_read": 124622, "tokens_cache_write": 98005, "tokens_fresh": 1815, "tokens_input_uncached": 16, "tokens_main_cache_read": 124622, "tokens_main_cache_write": 98005, "tokens_main_calls": 7, "tokens_main_input_uncached": 16, "tokens_main_output": 1799, "tokens_output": 1799, "tokens_proxy_cache_read": 124622, "tokens_proxy_cache_write": 98005, "tokens_proxy_calls": 7, "tokens_proxy_input_unc