 set number of times.\n`WeatherClient.get` in `weather.py` now retries when the server returns 503, making up to 3 attempts in total.\n\n- **Backoff:** it waits `backoff * 2**n` seconds between attempts. With the default `backoff=0.5`, that's 0.5s after the first failure and 1s after the second. The first attempt has no delay.\n- **New constructor options:** `max_attempts=3` and `backoff=0.5`. Existing calls don't need to change.\n- **Errors:** if all 3 attempts get a 503, the last 503 error is raised. Other HTTP errors and network errors are raised straight away without retrying.\n\nI ran it against a local test server:\n\n| Server behaviour | Result | Requests made |\n|---|---|---|\n| Works first time | data returned | 1 |\n| 503 twice, then works | data returned | 3 |\n| 503 three times | 503 error raised | 3 |\n| 500 once | 500 error raised | 1 |\n\nI didn't add a test file; the repo had no tests to begin with.", "paced_wait_s": 0.0, "params_stripped": [], "params_stripped_requests": 0, "permission_rejections": 0, "read_calls": 1, "replies_ok": 5, "replies_throttled": 0, "requests_cache_read": 70130, "requests_cache_write": 108414, "requests_cost_usd": 0.5911439999999999, "requests_count": 5, "requests_input_uncached": 12, "requests_output": 1750, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-netclient:claude-opus-5-5:trial18", "run_seed": 1016, "sampling_observed": null, "schedule_index": 95, "score": 1.0, "started_at": "2026-10-20T03:50:09.758472+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 21.007, "t_checker_s": 2.382, "t_env_setup_s": 0.0, "task": "trig-omp-netclient", "task_calls": 0, "thinking_mode": "off", "thinking_sent": ["none", "none", "none", "none", "none"], "timeout_s": 840, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 1762, "tokens_cache_read": 70130, "tokens_cache_