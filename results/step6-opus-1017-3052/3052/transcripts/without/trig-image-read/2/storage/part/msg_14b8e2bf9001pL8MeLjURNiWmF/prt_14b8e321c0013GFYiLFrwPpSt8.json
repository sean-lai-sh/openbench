      "command": "cd /tmp/obench-cell-7678ajpw/bench_opencode_trig-image-read_yred1a_w && python3 -c \"\nimport zlib,struct\nd=open('spec.png','rb').read()\np=8;idat=b''\nwhile p<len(d):\n  l,=struct.unpack('>I',d[p:p+4]);t=d[p+4:p+8];c=d[p+8:p+8+l];p+=12+l\n  if t==b'IHDR':w,h=struct.unpack('>II',c[:8])\n  if t==b'IDAT':idat+=c\nr=zlib.decompress(idat);bpp=3;s=w*bpp;prev=bytearray(s);rows=[]\ni=0\nfor y in range(h):\n  f=r[i];i+=1;cur=bytearray(r[i:i+s]);i+=s\n  for x in range(s):\n    a=cur[x-bpp] if x>=bpp else 0;b=prev[x];c=prev[x-bpp] if x>=bpp else 0\n    if f==1:cur[x]=(cur[x]+a)&255\n    elif f==2:cur[x]=(cur[x]+b)&255\n    elif f==3:cur[x]=(cur[x]+(a+b)//2)&255\n    elif f==4:\n      pp=a+b-c;pa,pb,pc=abs(pp-a),abs(pp-b),abs(pp-c)\n      cur[x]=(cur[x]+(a if pa<=pb and pa<=pc else b if pb<=pc else c))&255\n  rows.append(cur);prev=cur\nfor row in rows:\n  print(''.join('#' if sum(row[x*3:x*3+3])<384 else ' ' for x in range(w)).rstrip())\n\"",
