      "command": "cd /tmp/obench-cell-lsmeodu2/bench_opencode_trig-image-read_dkdnuah6 && python3 -c \"\nimport zlib,struct\nd=open('spec.png','rb').read()\ni=8;idat=b''\nwhile i<len(d):\n    l,t=struct.unpack('>I4s',d[i:i+8]);c=d[i+8:i+8+l]\n    if t==b'IHDR':w,h,bd,ct=struct.unpack('>IIBB',c[:10])\n    if t==b'IDAT':idat+=c\n    i+=12+l\nprint(w,h,bd,ct)\nraw=zlib.decompress(idat)\nbpp={0:1,2:3,4:2,6:4}[ct]*(bd//8)\nstride=w*bpp;rows=[];prev=bytearray(stride);p=0\nfor y in range(h):\n    f=raw[p];p+=1;line=bytearray(raw[p:p+stride]);p+=stride\n    for x in range(stride):\n        a=line[x-bpp] if x>=bpp else 0;b=prev[x];cc=prev[x-bpp] if x>=bpp else 0\n        if f==1:line[x]=(line[x]+a)&255\n        elif f==2:line[x]=(line[x]+b)&255\n        elif f==3:line[x]=(line[x]+(a+b)//2)&255\n        elif f==4:\n            pp=a+b-cc;pa,pb,pc=abs(pp-a),abs(pp-b),abs(pp-cc)\n            line[x]=(line[x]+(a if pa<=pb and pa<=pc else b if pb<=pc else cc))&255\n    rows.append(line);prev=line\nfor y in range(h):\n    print(''.join('#' if rows[y][x*bpp]<128 else ' ' for x in range(w)).rstrip())\n\" | awk 'NF' | head -80",
