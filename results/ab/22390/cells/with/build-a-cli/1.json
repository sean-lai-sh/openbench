and the count separated by a single space, each line ending with a\nnewline.\n\nOrdering rules:\n\n- Sort by count, highest first.\n- Break ties between words with equal counts alphabetically (ascending).\n- If the file has fewer than `N` distinct words, print all of them.\n- If `N` is `0`, print nothing.\n\n## Example\n\nA sample file `sample.txt` is included. Running:\n\n```\npython3 wordcount.py sample.txt 3\n```\n\nshould print:\n\n```\nthe 3\nfox 2\nquick 2\n```\n\nDone when `wordcount.py` behaves exactly as specified above.\n"], "completed": true, "error": null, "exec_mode": "local", "failure_class": "solved", "failure_reason": null, "harness": "opencode", "harness_version": "0.0.0--202610050515 (/workspace/openbench-ab/results/opencode-src/bin/4f967d5bc05d545fde9deccdb632276ec642722e/opencode)", "harness_version_source": "host", "host": "grok-bot-vm-412615941", "image_digest": null, "last_activity_age_s": null, "model": "claude-opus-5-5", "model_context_window": null, "model_max_tokens": null, "output_tail": "[tool: bash]\n[tool: write]\n[tool: bash]", "paced_wait_s": null, "replies_ok": null, "replies_throttled": null, "run_id": "opencode:build-a-cli:claude-opus-5-5:trial1", "sampling_observed": null, "score": 1.0, "success": true, "t_agent_s": 71.573, "t_checker_s": 0.228, "t_env_setup_s": 0.001, "task": "build-a-cli", "timeout_s": 2400, "token_basis": "vendor_split", "token_basis_proxy": null, "tokens": 1067, "tokens_cache_read": 0, "tokens_cache_write": 46973, "tokens_fresh": 1067, "tokens_input_uncached": 8, "tokens_output": 1059, "tokens_proxy_cache_read": null, "tokens_proxy_cache_write": null, "tokens_proxy_calls": null, "tokens_proxy_input_uncached": null, "tokens_proxy_output": null, "tokens_proxy_reasoning": null, "tokens_reasoning": 0, "trial": 1, "ts_iso": "2026-10-05T01:15:39", "turns": 3, "usage_raw": [{"cache": {"read": 0, "write": 15401}, "input": 4, "output": 223, "reasoning": 0, "total": 15628}, {"cache": {"read": 0, "write": 15521}, "input