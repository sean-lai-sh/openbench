# H2 env (pre-reg v2 + A1 + A2 sha256 a8668fc6641bc9eeb855065688fbbc02a0d3754c0021013e5169b4b0b0b88814):
# h1-env:1022 + warm uv cache for all 9 checker uvx envs (incl. torch), baked so every cell starts from the same cache.
FROM h1-env:1022
ENV UV_CACHE_DIR=/opt/uvcache
COPY tests /opt/h2-checkers
COPY prewarm.sh /opt/prewarm.sh
RUN bash /opt/prewarm.sh && chmod -R a+rwX /opt/uvcache
