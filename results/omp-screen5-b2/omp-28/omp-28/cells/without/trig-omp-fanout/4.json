HONPATH=. uvx pytest -q -W error::DeprecationWarning`.\n\n**Behaviour changes for callers outside this repo:**\n- **Timezone-aware results:** `billing.due_date`, `reports.generated_at`, `audit.stamp()[\"at\"]`, the timestamps from `sessions.new_session` and `cache.Entry.expires` now carry a timezone. Comparing or subtracting them against old-style datetimes with no timezone now raises `TypeError`. Nothing in this repo does that.\n- **Report header text:** `reports.header()` now ends its timestamp with `+00:00`, e.g. `T generated 2026-10-13T12:00:00+00:00`. Anything that parses that string exactly will see the suffix. The test only checks the prefix, so it still passes.", "paced_wait_s": 0.0, "permission_rejections": 0, "read_calls": 1, "replies_ok": 9, "replies_throttled": 0, "requests_cache_read": 148231, "requests_cache_write": 186942, "requests_cost_usd": 1.0063642, "requests_count": 9, "requests_input_uncached": 22, "requests_output": 2096, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-fanout:claude-opus-5-5:trial4", "run_seed": 20261014, "sampling_observed": null, "schedule_index": 6, "score": 1.0, "started_at": "2026-10-13T03:26:10.080683+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 32.566, "t_checker_s": 0.38, "t_env_setup_s": 0.001, "task": "trig-omp-fanout", "task_calls": 0, "thinking_mode": "default", "thinking_sent": ["adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive"], "timeout_s": 360, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 2118, "tokens_cache_read": 148231, "tokens_cache_write": 186942, "tokens_fresh": 2118, "tokens_input_uncached": 22, "tokens_main_cache_read": 148231, "tokens_main_cache_write": 186942, "tokens_main_calls": 9, "tokens_main_input_uncached": 22, "tokens_main_output": 2096, "tokens_output": 2096