 test only checks the start of the string, but anything that parses this header will see the new suffix.\n- **Mixing old and new times:** every returned datetime now carries a timezone. If any outside code compares or subtracts these against timezone-less datetimes (from older stored data, a database, or other code), Python will raise `TypeError`. `cache.Entry` is fine because both its values come from the same source now.", "paced_wait_s": 0.0, "permission_rejections": 0, "read_calls": 1, "replies_ok": 8, "replies_throttled": 0, "requests_cache_read": 144953, "requests_cache_write": 150314, "requests_cost_usd": 0.8122206000000001, "requests_count": 8, "requests_input_uncached": 20, "requests_output": 1579, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-fanout:claude-opus-5-5:trial5", "run_seed": 20261014, "sampling_observed": null, "schedule_index": 8, "score": 1.0, "started_at": "2026-10-13T03:26:37.932798+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 26.6, "t_checker_s": 0.379, "t_env_setup_s": 0.001, "task": "trig-omp-fanout", "task_calls": 0, "thinking_mode": "default", "thinking_sent": ["adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive", "adaptive"], "timeout_s": 360, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 1599, "tokens_cache_read": 144953, "tokens_cache_write": 150314, "tokens_fresh": 1599, "tokens_input_uncached": 20, "tokens_main_cache_read": 144953, "tokens_main_cache_write": 150314, "tokens_main_calls": 8, "tokens_main_input_uncached": 20, "tokens_main_output": 1579, "tokens_output": 1579, "tokens_proxy_cache_read": 144953, "tokens_proxy_cache_write": 150314, "tokens_proxy_calls": 8, "tokens_proxy_input_uncached": 20, "tokens_proxy_output": 1579, "tokens_proxy_reasoning": null, "tokens_reasoning": 0, "trial": 5, "ts_iso": "2026-10-12T20:2