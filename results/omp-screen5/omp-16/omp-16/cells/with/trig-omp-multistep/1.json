s round away from zero (`-1.005 \u2192 -101`). If any callers relied on the old cut-off behaviour, they will now get different numbers.", "paced_wait_s": 0.0, "permission_rejections": 0, "read_calls": 0, "replies_ok": 8, "replies_throttled": 0, "requests_cache_read": 169871, "requests_cache_write": 78086, "requests_cost_usd": 0.46765619999999997, "requests_count": 8, "requests_input_uncached": 18, "requests_output": 2159, "reread": false, "rule_order": "none", "rule_prefix": "neither", "run_id": "omp:trig-omp-multistep:claude-opus-5-5:trial1", "run_seed": 20261014, "sampling_observed": null, "schedule_index": 1, "score": 1.0, "started_at": "2026-10-12T23:41:19.127016+00:00", "subagent_resumed": false, "subagent_write_calls": 0, "success": true, "t_agent_s": 29.019, "t_checker_s": 0.381, "t_env_setup_s": 0.001, "task": "trig-omp-multistep", "task_calls": 0, "timeout_s": 360, "tmpdir_leaked_dirs": 0, "token_basis": "proxy_measured", "token_basis_main": "estimated", "token_basis_proxy": "proxy_measured", "tokens": 2177, "tokens_cache_read": 169871, "tokens_cache_write": 78086, "tokens_fresh": 2177, "tokens_input_uncached": 18, "tokens_main_cache_read": 169871, "tokens_main_cache_write": 78086, "tokens_main_calls": 8, "tokens_main_input_uncached": 18, "tokens_main_output": 2159, "tokens_output": 2159, "tokens_proxy_cache_read": 169871, "tokens_proxy_cache_write": 78086, "tokens_proxy_calls": 8, "tokens_proxy_input_uncached": 18, "tokens_proxy_output": 2159, "tokens_proxy_reasoning": null, "tokens_reasoning": 0, "trial": 1, "ts_iso": "2026-10-12T16:41:21", "turn_mode": null, "turns": 8, "usage_raw": [{"cacheRead": 0, "cacheWrite": 29513, "cost": {"cacheRead": 0, "cacheWrite": 0, "input": 0, "output": 0, "total": 0}, "input": 4, "output": 102, "totalTokens": 29619}, {"cacheRead": 15748, "cacheWrite": 14142, "cost": {"cacheRead": 0, "cacheWrite": 0, "input": 0, "output": 0, "total": 0}, "input": 2, "output": 83, "totalTokens": 29975}, {"cacheRead": 29513, "cacheWrite": 674